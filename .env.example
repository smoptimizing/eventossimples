# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Endereço público do site (links do comprovante, webhooks e OAuth do Mercado Pago)
NEXT_PUBLIC_SITE_URL=http://localhost:5001
NEXT_PUBLIC_SITE_NAME=Inscreva

# Criptografa as chaves dos gateways dos Clientes. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA troque depois de cadastrar Clientes (as chaves salvas deixariam de abrir).
PAYMENT_SECRET_KEY=

# ---- Taxa da plataforma ----
# Sem split (padrão): o Cliente recebe tudo e paga a taxa depois (extrato em /painel/taxas).
# Chave Pix exibida ao Cliente para pagar a taxa:
PLATFORM_PIX_KEY=
PLATFORM_PIX_NAME=
# 1 = ligar o split (o gateway separa a taxa no pagamento; exige as contas abaixo)
PAYMENT_SPLIT=

# ---- Split: contas da PLATAFORMA que recebem a taxa (só com PAYMENT_SPLIT=1) ----
# Asaas: walletId da sua conta (GET /v3/wallets com a sua chave)
ASAAS_PLATFORM_WALLET_ID=
# Mercado Pago: aplicação (marketplace) criada no painel de desenvolvedor da SUA conta
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# PagBank: ID da sua conta (ACCO_...)
PAGBANK_PLATFORM_ACCOUNT_ID=

# E-mail do administrador: recebe aviso de evento aguardando aprovação
ADMIN_EMAIL=

# E-mail do comprovante (opcional, https://resend.com). Sem chave, o comprovante fica só no link.
RESEND_API_KEY=
EMAIL_FROM="Inscreva <inscricoes@seudominio.com.br>"
